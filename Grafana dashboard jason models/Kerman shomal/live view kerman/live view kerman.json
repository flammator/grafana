        "current": {},
        "definition": " SELECT DISTINCT CONCAT('queue=','\"',q.ext_number,'\"','queue_name=','\"',q.name,'\"') FROM `queues` q JOIN `departments` d ON q.`department_id` = d.`id` JOIN `profiles` p \nON d.`id` = p.`department_id` LEFT JOIN `users` u ON p.`id` = u.`profile_id` WHERE  '${__user.login}' = u.`username` OR 1<=(SELECT COUNT(*) FROM `users` u JOIN `groups_users` gu ON u.`id` = gu.user_id \nJOIN `groups_special_permissions` gsp ON gu.group_id = gsp.group_id  JOIN `special_permissions` sp \nON gsp.special_permission_id = sp.id WHERE  '${__user.login}' = u.`username`  AND sp.name = 'Agent Supervisor')",
        "name": "queue",
        "options": [],
        "query": " SELECT DISTINCT CONCAT('queue=','\"',q.ext_number,'\"','queue_name=','\"',q.name,'\"') FROM `queues` q JOIN `departments` d ON q.`department_id` = d.`id` JOIN `profiles` p \nON d.`id` = p.`department_id` LEFT JOIN `users` u ON p.`id` = u.`profile_id` WHERE  '${__user.login}' = u.`username` OR 1<=(SELECT COUNT(*) FROM `users` u JOIN `groups_users` gu ON u.`id` = gu.user_id \nJOIN `groups_special_permissions` gsp ON gu.group_id = gsp.group_id  JOIN `special_permissions` sp \nON gsp.special_permission_id = sp.id WHERE  '${__user.login}' = u.`username`  AND sp.name = 'Agent Supervisor')",
